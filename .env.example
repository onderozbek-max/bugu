# Copy to .env.local and set to "true" AFTER the proposal to permanently
# switch the deployed site into Album Mode. Leave unset/false until then.
VITE_ALBUM_MODE=false

# Optional. Points at a tiny hosted endpoint you control that GETs/POSTs
# { "albumMode": boolean } — lets the /admin panel flip Album Mode
# globally (Buğu's phone picks it up on its own) instead of only
# unlocking the device you're standing on. See README "Album Mode
# activation" for minimal backend recipes. Leave unset to skip this —
# the admin panel still works, it just says so honestly.
VITE_ALBUM_FLAG_ENDPOINT=
